digraph G {
    rankdir=TB;
    labelloc="t";
    label="检索增强生成（RAG）架构";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.55, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_offline {
        label="离线：知识库构建";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        doc [label="企业文档/代码库"];
        chunk [label="文本分块\n（语义完整·大小与重叠）"];
        index [label="向量化并建立索引\n（向量数据库）"];
        doc -> chunk;
        chunk -> index;
    }

    subgraph cluster_online {
        label="在线：检索与生成";
        style="rounded,dashed";
        color="#E8833A";
        fontcolor="#2C5F8A";
        q [label="用户提问"];
        hybrid [label="混合检索\n（向量+关键词）"];
        rerank [label="融合与重排\n（最相关内容进上下文）"];
        prompt [label="拼入提示词\n（预算内取舍）"];
        answer [label="LLM 基于上下文作答", fillcolor="#2C5F8A", fontcolor="white"];
        q -> hybrid;
        hybrid -> rerank;
        rerank -> prompt;
        prompt -> answer;
    }

    { rank=same; doc; q; hybrid }
    { rank=same; chunk; rerank; prompt }
    { rank=same; index; answer }

    index -> hybrid;
}
