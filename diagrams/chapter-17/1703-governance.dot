digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能体质量与治理";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="评测\n通过测试为最终标准"];
    b [label="安全与合规\n扫描与隐私检查"];
    m [label="智能体进入生产", fillcolor="#2C5F8A", fontcolor="white"];
    c [label="幻觉与技术债\n持续重构·人工把关", fillcolor="#FCE9DB", color="#E8833A"];
    d [label="可追溯与责任\n记录来源·审计链路", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; a; b }
    { rank=same; m }
    { rank=same; c; d }

    a -> m;
    b -> m;
    m -> c;
    m -> d;
}
