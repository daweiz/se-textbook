digraph G {
    rankdir=TB;
    labelloc="t";
    label="可演化架构的持续演进";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.85, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="定义架构决策与约束"];
    n2 [label="定义架构适应度函数\n（自动化检查度量）"];
    n3 [label="持续交付新功能"];
    n4 [label="执行适应度函数\n（CI 中自动评估）"];
    d1 [label="违反适应度？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    n5 [label="重构与修复\n（AI 辅助识别方案）", fillcolor="#FCE9DB", color="#E8833A"];
    d2 [label="系统持续演进？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; n1; n2; n3; n4 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d1;
    d1 -> n5 [label="是"];
    d1 -> d2 [xlabel="否"];
    n5 -> d2;
    d2 -> fin [label="否"];
    d2 -> n3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="是（继续演进）"];
}
