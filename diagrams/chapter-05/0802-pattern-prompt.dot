digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能生成模式代码流程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.75, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="描述意图与变化点"];
    n2 [label="构造提示词"];
    n3 [label="AI 生成模式代码"];
    n4 [label="对照评审清单审查"];
    d [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    y [label="测试后进入基线", fillcolor="#2C5F8A", fontcolor="white"];
    n [label="修正提示词重新生成", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d }
    { rank=same; y; n }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> y [label="是"];
    d -> n [label="否"];
    n -> n3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="循环"];
}
