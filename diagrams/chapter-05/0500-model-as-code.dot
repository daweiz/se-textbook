digraph G {
    rankdir=TB;
    labelloc="t";
    label="建模即代码的生成链";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.85, splines=ortho, pad=0.25, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="建模文本\n（Mermaid/PlantUML/OCL）"];
    n2 [label="版本控制与评审\n（模型作为可审查资产）"];
    n3 [label="渲染为图形\n（文档/演示/评审视图）"];
    n4 [label="生成代码骨架与测试"];
    n5 [label="图校验与一致性检查\n（CI 中执行）"];
    d1 [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    ok [label="进入基线\n（模型-代码-文档同步）", fillcolor="#2C5F8A", fontcolor="white"];
    no [label="修订模型文本", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; n5; d1 }
    { rank=same; ok; no }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> n5;
    n5 -> d1;
    d1 -> ok [label="是"];
    d1 -> no [label="否"];
}
