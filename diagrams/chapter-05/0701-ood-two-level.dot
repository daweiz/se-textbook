digraph G {
    rankdir=TB;
    labelloc="t";
    label="面向对象设计的两层工作";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=1.1, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    am [label="分析模型"];
    sys [label="系统设计\n体系结构·数据存储·部署"];
    obj [label="对象设计\n精化属性操作·明确关系"];

    { rank=same; sys; obj }

    am -> sys [label="识别设计元素"];
    sys -> obj [xlabel="细化设计模型", constraint=false];
}
