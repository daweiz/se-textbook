digraph G {
    rankdir=LR;
    labelloc="t";
    label="软件分层架构依赖图";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=1.3, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    P [label="表示层"];
    B [label="业务逻辑层"];
    DM [label="领域模型"];
    DA [label="数据访问层"];
    DB [label="数据库"];
    I [label="基础设施", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; P; I }
    { rank=same; DM; DA }

    P -> B;
    B -> DM;
    B -> DA;
    DA -> DB;
    I -> B [style=dashed, color="#E8833A", fontcolor="#E8833A", label="依赖注入"];
}
