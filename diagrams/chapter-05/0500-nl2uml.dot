digraph G {
    rankdir=TB;
    labelloc="t";
    label="自然语言到 UML 生成的质量控制";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.85, splines=ortho, pad=0.25, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="自然语言需求描述"];
    n2 [label="明确语义约束\n（关联/聚合·消息时序·状态条件）"];
    n3 [label="生成 UML 建模文本"];
    n4 [label="可执行校验\n（关系合法性·状态完备与一致）"];
    d1 [label="校验通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    ok [label="进入模型基线", fillcolor="#2C5F8A", fontcolor="white"];
    no [label="补充语义约束\n重新生成", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d1; ok }
    { rank=same; no }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d1;
    d1 -> ok [xlabel="是"];
    d1 -> no [label="否"];
    no -> n2 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="重新生成"];
}
