digraph G {
    rankdir=TB;
    labelloc="t";
    label="LLM 应用可观测性分层";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=1.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_chain {
        label="调用链路";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        req [label="用户请求"];
        retr [label="检索\n命中文档·Token"];
        model [label="模型调用\n版本·Token·延迟"];
        resp [label="响应\n质量校验"];
        { rank=same; req; retr; model; resp }
    }

    subgraph cluster_obs {
        label="观测与监控";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        trace [label="链路追踪\nrequest_id"];
        metric [label="指标监控\n延迟·Token·成本"];
        log [label="日志与审计"];
        { rank=same; trace; metric; log }
    }

    subgraph cluster_govern {
        label="治理动作";
        style="rounded,dashed";
        color="#E8833A";
        fontcolor="#2C5F8A";
        degrade [label="降级与熔断\n超时·重试·兜底", fillcolor="#FCE9DB", color="#E8833A"];
        canary [label="灰度发布\n评测集+监控", fillcolor="#FCE9DB", color="#E8833A"];
        { rank=same; degrade; canary }
    }

    req -> retr;
    retr -> model;
    model -> resp;

    retr -> trace [style=dashed, color="#9AA7B4"];
    model -> trace [style=dashed, color="#9AA7B4"];
    resp -> trace [style=dashed, color="#9AA7B4"];
    trace -> metric;
    metric -> log;
    model -> degrade [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="异常"];
    resp -> canary [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="变更"];
}
