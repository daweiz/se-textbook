digraph G {
    rankdir=TB;
    labelloc="t";
    label="多模型路由";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=1.0, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    req [label="任务请求"];
    cache [label="缓存命中", fillcolor="#FCE9DB", color="#E8833A"];
    router [label="路由决策\n按难度·成本·质量", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    light [label="轻量模型\n分类·抽取"];
    general [label="通用模型\n摘要·问答"];
    high [label="高能力模型\n推理·代码"];
    check [label="质量校验\n评测+护栏"];
    upgrade [label="升级重试\n更高能力模型", fillcolor="#FCE9DB", color="#E8833A"];
    resp [label="返回响应"];

    { rank=same; req }
    { rank=same; router; cache }
    { rank=same; light; general; high }
    { rank=same; check }
    { rank=same; upgrade }
    { rank=same; resp }

    req -> router;
    req -> cache [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="同请求命中"];
    cache -> resp [constraint=false];
    router -> light [xlabel="简单"];
    router -> general [xlabel="常规"];
    router -> high [xlabel="复杂"];
    light -> check;
    general -> check;
    high -> resp [constraint=false];
    check -> resp [xlabel="通过"];
    check -> upgrade [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="不达标"];
    upgrade -> resp;
}
