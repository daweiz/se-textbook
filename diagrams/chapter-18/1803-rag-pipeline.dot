digraph G {
    rankdir=TB;
    labelloc="t";
    label="RAG 工程化流水线";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=1.2, ranksep=0.55, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_offline {
        label="离线：索引构建";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        doc [label="文档接入"];
        clean [label="清洗去重"];
        chunk [label="分块\n大小·重叠·语义"];
        embed [label="向量化"];
        index [label="建立索引\n（向量+关键词）"];
        doc -> clean;
        clean -> chunk;
        chunk -> embed;
        embed -> index;
    }

    subgraph cluster_online {
        label="在线：检索与生成";
        style="rounded,dashed";
        color="#E8833A";
        fontcolor="#2C5F8A";
        query [label="用户查询"];
        rewrite [label="查询改写"];
        hybrid [label="混合检索\n（向量+关键词）"];
        rerank [label="融合与重排\n（最相关内容）"];
        context [label="拼入上下文\n（预算内取舍）"];
        answer [label="LLM 生成\n引用溯源", fillcolor="#2C5F8A", fontcolor="white"];
        query -> rewrite;
        rewrite -> hybrid;
        hybrid -> rerank;
        rerank -> context;
        context -> answer;
    }

    { rank=same; doc; query }
    { rank=same; clean; rewrite }
    { rank=same; chunk; hybrid }
    { rank=same; embed; rerank }
    { rank=same; index; context }
    { rank=same; answer }

    index -> hybrid;
    index -> clean [constraint=false, style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="增量更新\n（版本比对·去重）"];
}
