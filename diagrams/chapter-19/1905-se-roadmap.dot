digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能软件工程路线图";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.8, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.16,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    s1 [label="传统软件工程\n经典方法 · 人写人审", fillcolor="#FCE9DB", color="#E8833A"];
    s2 [label="AI4SE\nAI 赋能软件过程\n需求·设计·编码·测试"];
    s3 [label="SE4AI\n工程纪律约束 AI\n数据 · 评测 · MLOps"];
    s4 [label="智能体协作\n人机混合团队\n策展 · 验证优先"];
    s5 [label="智能软件工程组织\n角色 · 权限 · 评测 · 治理", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; s1; s2 }
    { rank=same; s3; s4 }

    s1 -> s2;
    s2 -> s3;
    s3 -> s4;
    s4 -> s5;
}
