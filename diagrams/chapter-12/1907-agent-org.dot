digraph G {
    rankdir=LR;
    labelloc="t";
    label="智能软件工程组织：人机混合团队";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.0, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_h {
        label="工程师";
        style="rounded,dashed";
        color="#2C5F8A";
        h1 [label="目标定义\n质量把关"];
        h2 [label="异常接管\n责任归属"];
    }

    subgraph cluster_a {
        label="智能体（可考核成员）";
        style="rounded,dashed";
        color="#2C5F8A";
        a1 [label="高频可验证\n执行环节"];
        a2 [label="产出接受\n评测考核"];
    }

    hub [label="任务集\n评测集\n审批流\n（基础设施）", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; h1; hub; a1 }
    hub -> a1;
    a1 -> hub [label="产出"];
    hub -> h2 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="异常/责任"];
    h2 -> a2 [label="接管/复盘", style=dashed, color="#E8833A", fontcolor="#E8833A"];
    a2 -> hub [label="回灌", style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
