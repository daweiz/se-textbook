digraph G {
    rankdir=TB;
    labelloc="t";
    label="编码智能体的团队协作与审批流";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.55, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.16,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="编码智能体\n隔离分支完成改动\n（附说明 · AI 自检）"];
    b1 [label="自动检查（硬门禁）\n静态扫描 + 单元测试"];
    b2 [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    c1 [label="人工审查\n高风险改动强制评审\n（数据层 · 并发 · 安全）", fillcolor="#FCE9DB", color="#E8833A"];
    d1 [label="合入基线并记录来源\n（模型 · 提示词 · 分支）", fillcolor="#2C5F8A", fontcolor="white"];
    d2 [label="缺陷复盘\n回灌评测集", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; a1; b1 }
    { rank=same; b2; c1 }
    { rank=same; d1; d2 }

    a1 -> b1;
    b1 -> b2;
    b2 -> c1 [xlabel="否"];
    b2 -> d1 [xlabel="是"];
    c1 -> d1;
    c1 -> a1 [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="打回修复", constraint=false];
    d1 -> d2 [style=dashed, xlabel="复盘"];
}
