digraph G {
    rankdir=TB;
    labelloc="t";
    label="单智能体的思考—行动—观察循环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.55, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.16,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    goal [label="用户目标", fillcolor="#2C5F8A", fontcolor="white"];
    think [label="思考\n（推理下一步）"];
    act  [label="行动\n（沙箱内调用工具）"];
    obs  [label="观察\n（读取结果与错误）"];
    done [label="目标达成？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    fin  [label="完成\n（附证据验证）", fillcolor="#2C5F8A", fontcolor="white"];
    back [label="调整计划", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; goal; think }
    { rank=same; act; obs }
    { rank=same; done; fin }
    { rank=same; back }

    goal -> think;
    think -> act;
    act -> obs;
    obs -> done;
    done -> fin [xlabel="是"];
    done -> back [xlabel="否"];
    back -> think [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="返回调整", constraint=false];
}
