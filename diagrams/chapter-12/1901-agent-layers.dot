digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能体系统的工程分层";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.45, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    app [label="智能体应用\n（角色 · 目标 · 入口）", fillcolor="#2C5F8A", fontcolor="white"];
    rt  [label="运行时"];
    m1  [label="执行循环 · 工具注册 · 状态管理"];
    tp  [label="工具协议"];
    m2  [label="函数调用 · OpenAPI · 自定义"];
    mem [label="记忆与状态"];
    m3  [label="短期上下文 · 长期存储"];
    sec [label="安全边界", fillcolor="#FCE9DB", color="#E8833A"];
    m4  [label="权限最小化 · 沙箱 · 白名单 · 审计", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; rt; m1 }
    { rank=same; tp; m2 }
    { rank=same; mem; m3 }
    { rank=same; sec; m4 }

    app -> rt;
    rt -> tp;
    tp -> mem;
    mem -> sec;
    rt -> m1 [style=invis];
    tp -> m2 [style=invis];
    mem -> m3 [style=invis];
    sec -> m4 [style=invis];
}
