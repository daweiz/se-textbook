digraph G {
    rankdir=LR;
    labelloc="t";
    label="多智能体协作的三种编排拓扑";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.16,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="多智能体协作\n消息协议 · 交接 · 可观测性", fillcolor="#2C5F8A", fontcolor="white"];

    subgraph cluster_a {
        label="对话式 · AutoGen";
        style="rounded,dashed"; color="#4A90D9"; fontcolor="#2C5F8A";
        a1 [label="需求分析师"];
        a2 [label="架构师"];
        a3 [label="测试工程师"];
        a1 -> a2;
        a2 -> a3;
    }

    subgraph cluster_b {
        label="角色化 · CrewAI";
        style="rounded,dashed"; color="#4A90D9"; fontcolor="#2C5F8A";
        b1 [label="任务派发"];
        b2 [label="角色执行"];
        b1 -> b2;
    }

    subgraph cluster_c {
        label="图式状态机 · LangGraph";
        style="rounded,dashed"; color="#4A90D9"; fontcolor="#2C5F8A";
        c1 [label="状态 S0"];
        c2 [label="决策", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
        c3 [label="状态 S1"];
        c1 -> c2;
        c2 -> c3;
    }

    hub -> a1;
    hub -> b1;
    hub -> c1;
}
