digraph G {
    rankdir=LR;
    labelloc="t";
    label="两种复用导向的方法";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10, margin="0.18,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=9, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.1];

    subgraph cluster_comp {
        label="基于组件的方法";
        style=dashed; color="#9AA7B4"; fontcolor="#2C5F8A"; fontname="Microsoft YaHei"; fontsize=12;
        c1 [label="可独立开发\n组装·替换"];
        c2 [label="二进制级复用\n（JavaBeans/.NET）"];
        c1 -> c2 [style=invis];
    }

    hub [label="以复用为宗旨", fillcolor="#2C5F8A", fontcolor="white"];

    subgraph cluster_svc {
        label="面向服务的方法";
        style=dashed; color="#9AA7B4"; fontcolor="#2C5F8A"; fontname="Microsoft YaHei"; fontsize=12;
        s1 [label="能力封装为\n网络服务"];
        s2 [label="服务契约·服务编排\n松耦合"];
        s1 -> s2 [style=invis];
    }

    c1 -> hub;
    c2 -> hub;
    s1 -> hub;
    s2 -> hub;
}
