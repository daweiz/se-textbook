digraph G {
    rankdir=TB;
    labelloc="t";
    label="意图驱动开发流程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    s1 [label="用户以自然语言\n描述意图"];
    s2 [label="AI 拆解为任务清单\n（规格/接口/测试先行）"];
    s3 [label="生成代码骨架\n与测试"];
    s4 [label="自动检查\n+ 测试执行"];
    d1 [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    s5 [label="合并入基线"];
    b1 [label="反馈修正\n并重新生成", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; s1; s2; s3 }
    { rank=same; s4; d1; s5 }
    { rank=same; b1; fin }

    s1 -> s2;
    s2 -> s3;
    s3 -> s4;
    s4 -> d1;
    d1 -> s5 [xlabel="是"];
    d1 -> b1 [label="否"];
    b1 -> s3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="重新生成"];
    s5 -> fin;
}
