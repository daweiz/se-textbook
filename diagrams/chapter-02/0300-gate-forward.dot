digraph G {
    rankdir=TB;
    labelloc="t";
    label="质量门禁前移机制";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    c1 [label="需求变更\n触发一致性检查\n（新旧需求冲突·遗漏）"];
    c2 [label="代码提交\n触发静态分析与测试生成\n（规则扫描·单元测试）"];
    c3 [label="版本发布\n触发安全与合规扫描\n（漏洞·许可·隐私）"];
    d  [label="检查通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    yes [label="放行进入下一步", fillcolor="#2C5F8A", fontcolor="white"];
    no1 [label="人工处置与修正", fillcolor="#FCE9DB", color="#E8833A"];
    no2 [label="重新提交", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; c1; c2 }
    { rank=same; d; no1 }

    c1 -> c2;
    c2 -> c3;
    c3 -> d;
    d -> yes [label="是"];
    d -> no1 [xlabel="否"];
    no1 -> no2;
    no2 -> c3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="重新提交"];
}
