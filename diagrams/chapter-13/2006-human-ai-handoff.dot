digraph G {
    rankdir=LR;
    labelloc="t";
    label="AI 原生流程中的人机交接";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.0, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_h {
        label="人·定义与把关";
        style="rounded,dashed";
        color="#2C5F8A";
        h1 [label="定义意图\n与验收标准"];
        h2 [label="锁定规格\n评审规格"];
        h3 [label="审批高风险\n改动"];
        h4 [label="审查结果\n与关键路径"];
    }

    subgraph cluster_a {
        label="AI·执行与产出";
        style="rounded,dashed";
        color="#2C5F8A";
        a1 [label="分解任务\n生成子任务清单"];
        a2 [label="生成实现\n与测试文档"];
        a3 [label="自测执行\n自动检查"];
        a4 [label="通过门禁\n提交合入"];
    }

    hub [label="人机交接点\n（审批闸门）", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];

    { rank=same; h1; hub; a1 }
    h1 -> hub;
    hub -> a1;
    h2 -> hub [style=dashed, color="#E8833A", fontcolor="#E8833A", label="锁定"];
    a4 -> hub [label="请求审批"];
    hub -> h3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="高风险"];
    hub -> h4 [label="交付"];
    h3 -> hub [label="批准", style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
