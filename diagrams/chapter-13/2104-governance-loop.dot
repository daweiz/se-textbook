digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能软件工程的治理闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="度量\n暴露问题"];
    a2 [label="治理\n调整手段"];
    a3 [label="评测\n验证效果"];
    a4 [label="审计\n留存证据"];
    a5 [label="回灌\n更新评测集\n与任务集"];
    d1 [label="效果\n达标？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    fin [label="持续运行", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; a4; a5; d1 }
    { rank=same; fin }

    a1 -> a2;
    a2 -> a3;
    a3 -> d1;
    d1 -> a4 [xlabel="是"];
    d1 -> a2 [xlabel="否", style=dashed, color="#E8833A", fontcolor="#E8833A", label="再治理"];
    a4 -> a5;
    a5 -> a1 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="回灌"];
    a5 -> fin [xlabel="稳定"];
}
