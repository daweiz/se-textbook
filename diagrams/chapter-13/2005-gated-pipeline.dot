digraph G {
    rankdir=TB;
    labelloc="t";
    label="验证优先的分级质量门禁流水线";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_g1 {
        label="第一道闸·自动检查";
        style="rounded,dashed";
        color="#9AA7B4";
        a1 [label="静态分析\n单元测试\n安全扫描"];
    }
    subgraph cluster_g2 {
        label="第二道闸·AI 自评";
        style="rounded,dashed";
        color="#9AA7B4";
        a2 [label="AI 对照清单自查\n标注风险点"];
    }
    subgraph cluster_g3 {
        label="第三道闸·人工审查";
        style="rounded,dashed";
        color="#9AA7B4";
        a3 [label="高风险改动\n人工评审"];
    }

    st [label="AI 产出"];
    d1 [label="自动检查\n通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    d2 [label="AI 自评\n通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    d3 [label="风险高？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="回退修正", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="合入基线", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; d1; a1 }
    { rank=same; d2; a2 }
    { rank=same; d3; a3 }

    st -> d1;
    d1 -> a1 [xlabel="是"];
    d1 -> b1 [xlabel="否"];
    a1 -> d2;
    d2 -> a2 [xlabel="是"];
    d2 -> b1 [xlabel="否"];
    a2 -> d3;
    d3 -> a3 [xlabel="是"];
    d3 -> fin [xlabel="否"];
    a3 -> fin [label="通过"];
    a3 -> b1 [xlabel="打回", style=dashed, color="#E8833A", fontcolor="#E8833A"];
    b1 -> st [style=dashed, color="#E8833A", fontcolor="#E8833A", label="修正"];
}
