digraph G {
    rankdir=TB;
    labelloc="t";
    label="意图驱动开发的执行闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="意图捕获\n目标与约束"];
    a2 [label="意图规格化\n规格 + 验收标准"];
    a3 [label="任务分解\n子任务清单"];
    a4 [label="生成\n实现、测试、文档"];
    a5 [label="验证\n自动检查与门禁"];
    a6 [label="集成\n合入基线"];
    d1 [label="验收\n通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="回退修正\n按规格重生成", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="交付", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; a4; a5; a6 }
    { rank=same; d1; b1; fin }

    a1 -> a2;
    a2 -> a3;
    a3 -> a4;
    a4 -> a5;
    a5 -> d1;
    d1 -> fin [xlabel="是"];
    d1 -> b1 [xlabel="否"];
    b1 -> a4 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="修正"];
}
