digraph G {
    rankdir=TB;
    labelloc="t";
    label="AI 原生平台的四个能力层";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="AI 原生平台\n（共享基础设施）", fillcolor="#2C5F8A", fontcolor="white"];
    r1 [label="模型服务层\n接入、路由、缓存\n成本计量"];
    r2 [label="工具与智能体服务层\n注册、运行时、编排"];
    r3 [label="知识资产层\n代码索引、知识库\n评测集"];
    r4 [label="治理与可观测层\n门禁、审计、监控"];

    { rank=same; r1; r2 }
    { rank=same; hub; r3; r4 }

    hub -> r1;
    hub -> r2;
    hub -> r3;
    hub -> r4;
}
