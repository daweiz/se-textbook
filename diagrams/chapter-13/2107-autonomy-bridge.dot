digraph G {
    rankdir=LR;
    labelloc="t";
    label="从 AI 原生到自主软件工程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.0, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    s1 [label="AI 原生\n流程按 AI 能力\n重新组织"];
    s2 [label="自主软件工程\n智能体自主完成\n更多开发环节", fillcolor="#2C5F8A", fontcolor="white"];
    note [label="自主化边界\n是信任问题\n验证手段决定自主空间", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; s1; s2 }
    { rank=same; note }

    s1 -> s2;
    s2 -> note [style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
