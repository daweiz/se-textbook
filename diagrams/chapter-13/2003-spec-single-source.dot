digraph G {
    rankdir=TB;
    labelloc="t";
    label="规格即代码的单一事实来源";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.55, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="可校验规格\n（单一事实来源）", fillcolor="#2C5F8A", fontcolor="white"];
    r1 [label="需求\n规格化需求\n+ 验收测试"];
    r2 [label="设计\n接口契约\n与不变量"];
    r3 [label="实现\n满足规格\n的实现"];
    r4 [label="测试\n可执行验收\n与回归套件"];
    r5 [label="文档\n从规格\n生成"];
    r6 [label="运维\nSLO 与\n告警规则"];

    hub -> r1;
    hub -> r2;
    hub -> r3;
    hub -> r4;
    hub -> r5;
    hub -> r6;
    r1 -> r4 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="验收"];
}
