digraph G {
    rankdir=LR;
    labelloc="t";
    label="开发范式的演进：从文档驱动到 AI 原生";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.0, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.22,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.9, penwidth=1.3];

    s1 [label="传统软件工程\n流程载体：代码与文档\n分工：人写代码\n质量：阶段评审"];
    s2 [label="智能增强\n流程载体：代码为主\n分工：人写、AI 补全\n质量：评审 + AI 建议", fillcolor="#FCE9DB", color="#E8833A"];
    s3 [label="AI 原生\n流程载体：规格、上下文\n与工具\n分工：人定义、AI 执行\n质量：门禁前移、验证优先", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; s1; s2; s3 }

    s1 -> s2;
    s2 -> s3;
}