digraph G {
    rankdir=TB;
    labelloc="t";
    label="MLOps 全流程闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.4, ranksep=0.9, splines=ortho, pad=0.25, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="数据工程\n（采集/清洗/标注）"];
    a2 [label="模型开发\n（特征工程/实验）"];
    a3 [label="模型评测\n（指标/数据泄漏）"];
    a4 [label="部署上线\n（批处理/实时/边缘）"];
    a5 [label="运行监控\n（系统/数据漂移/性能）"];
    d1 [label="性能退化\n或漂移？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    d2 [label="系统仍在\n运行？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="重训练并\n晋升新版本", fillcolor="#FCE9DB", color="#E8833A"];
    b2 [label="模型评测", fillcolor="#FCE9DB", color="#E8833A"];
    b3 [label="再部署", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; a4; a5; b3 }
    { rank=same; d1; d2; fin }
    { rank=same; b1; b2 }

    a1 -> a2;
    a2 -> a3;
    a3 -> a4;
    a4 -> a5;
    a5 -> d1;
    d1 -> d2 [xlabel="否"];
    d2 -> fin [xlabel="否"];
    d1 -> b1 [label="是"];
    b1 -> b2;
    b2 -> b3;
    b3 -> a5 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="再部署"];
    d2 -> a5 [style=dashed, label="是（继续监控）"];
}
