digraph G {
    rankdir=LR;
    labelloc="t";
    label="LLMOps 相对 MLOps 的新增能力";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=1.0, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    m [label="MLOps 基础\n模型运维·监控\n·重训练", fillcolor="#2C5F8A", fontcolor="white"];
    v [label="向量数据库\n检索增强（RAG）"];
    g [label="输出护栏\n内容安全过滤"];
    p [label="提示词与版本管理\n提示词资产化·评测"];
    t [label="Token 成本治理\n按量计量·优化取舍"];

    { rank=same; m }
    { rank=same; v; g; p; t }

    m -> v [color="#4A90D9", penwidth=1.5];
    m -> g [color="#4A90D9", penwidth=1.5];
    m -> p [color="#4A90D9", penwidth=1.5];
    m -> t [color="#4A90D9", penwidth=1.5];
}
