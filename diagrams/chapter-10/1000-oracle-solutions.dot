digraph G {
    rankdir=TB;
    labelloc="t";
    label="测试预言问题的三类解决途径";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    p [label="测试预言问题\n（正确期望输出从何而来）", fillcolor="#2C5F8A", fontcolor="white"];
    a [label="规格与不变量预言\n（断言函数性质）"];
    b [label="差分测试\n（多个实现相互印证）"];
    c [label="蜕变测试\n（输入变换·断言输出关系）"];
    note [label="预言问题在复杂计算、并发行为与 AI 组件上\n尤为突出，三类途径常组合使用。", style="rounded,dashed,filled", fillcolor="#FCE9DB", color="#E8833A", fontcolor="#E8833A"];

    { rank=same; p }
    { rank=same; a; b; c }
    { rank=sink; note }

    p -> a;
    p -> b;
    p -> c;
    b -> note [style=invis];
}
