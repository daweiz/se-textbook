digraph G {
    rankdir=TB;
    labelloc="t";
    label="数据漂移检测闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="训练基线分布\n与在线输入分布"];
    a2 [label="统计差异检测\n（KL 散度·特征均值\n·类别比例）"];
    d1 [label="漂移超过\n阈值？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="告警并\n评估影响", fillcolor="#FCE9DB", color="#E8833A"];
    b2 [label="触发重训练", fillcolor="#FCE9DB", color="#E8833A"];
    b3 [label="新模型评测\n与晋升", fillcolor="#FCE9DB", color="#E8833A"];
    b4 [label="持续监控"];
    a3 [label="部署在线\n新模型"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2 }
    { rank=same; d1 }
    { rank=same; b1; b2; b3 }
    { rank=same; b4; a3; fin }

    a1 -> a2;
    a2 -> d1;
    d1 -> b1 [xlabel="是"];
    b1 -> b2;
    b2 -> b3;
    b3 -> a3;
    d1 -> b4 [xlabel="否"];
    b4 -> a3;
    a3 -> fin;
    b4 -> a2 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="持续监控"];
}
