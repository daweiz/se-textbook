digraph G {
    rankdir=LR;
    labelloc="t";
    label="智能化维护工作流";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="逆向文档化\n源码→设计文档/调用图"];
    n2 [label="缺陷预测\n历史数据训练模型→风险排序"];
    d1 [label="是否需要重构？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    y1 [label="AI 识别坏味道\n生成重构方案", fillcolor="#FCE9DB", color="#E8833A"];
    y2 [label="重构并回归测试\n（验证行为不变）", fillcolor="#FCE9DB", color="#E8833A"];
    n3 [label="运维监控（AIOps）\n异常/性能退化/数据漂移"];
    d2 [label="发现异常？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    y3 [label="AI 辅助定位并告警", fillcolor="#FCE9DB", color="#E8833A"];
    end [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; n1; n2 }
    { rank=same; d1; y1 }
    { rank=same; y2; n3 }
    { rank=same; d2; y3 }
    { rank=same; end }

    n1 -> n2;
    n2 -> d1;
    d1 -> y1 [label="是"];
    d1 -> n3 [label="否"];
    y1 -> y2;
    y2 -> n3;
    n3 -> d2;
    d2 -> y3 [label="是"];
    d2 -> end [xlabel="否"];
    y3 -> end;
}
