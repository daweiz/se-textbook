digraph G {
    rankdir=TB;
    labelloc="t";
    label="LLM 应用评测体系";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.8, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    evset [label="评测集\n场景·难度·防污染"];
    exec [label="批量执行\n离线集+红队"];
    judge [label="裁判评分\n人工复核"];
    metrics [label="多维指标\n事实·忠实·相关·安全"];
    baseline [label="对比基线\n历史版本"];
    gate [label="门禁判定", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    pass [label="发布", fillcolor="#2C5F8A", fontcolor="white"];
    regress [label="回归修复\n提示词·检索·模型", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; evset }
    { rank=same; exec; judge }
    { rank=same; metrics; baseline }
    { rank=same; pass; gate; regress }

    evset -> exec;
    exec -> judge;
    judge -> metrics;
    metrics -> baseline;
    baseline -> gate;
    gate -> pass [xlabel="通过"];
    gate -> regress [xlabel="回退", style=dashed, color="#E8833A", fontcolor="#E8833A"];
    regress -> evset [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="修复后再评测", constraint=false];
}
