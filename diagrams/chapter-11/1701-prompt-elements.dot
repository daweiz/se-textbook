digraph G {
    rankdir=TB;
    labelloc="t";
    label="提示词五要素";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="上下文\n背景与约束"];
    b [label="角色\n领域专家身份"];
    c [label="指令\n任务与输出格式"];
    d [label="示例\n少样本示范"];
    e [label="推理引导\n思维链 CoT"];

    { rank=same; a; b; c }
    { rank=same; d; e }

    a -> b;
    b -> c;
    c -> d;
    d -> e;
}
