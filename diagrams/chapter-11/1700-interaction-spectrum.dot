digraph G {
    rankdir=TB;
    labelloc="t";
    label="人机协同的交互谱系";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.35, ranksep=1.2, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.16,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="完全委托\n描述意图·验收"];
    b [label="引导委托\n设定边界·逐步把关"];
    c [label="结对协作\n逐行审查·实时纠偏"];
    d [label="专家咨询\n亲自编写·片段建议"];
    note [label="AI 自主 ————————→ 人工主导\n人的控制渐强 · 质量更可控\n风险越高越应靠右",
          fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; a; b; c; d }
    { rank=same; note }

    a -> b;
    b -> c;
    c -> d;
    d -> note;
}
