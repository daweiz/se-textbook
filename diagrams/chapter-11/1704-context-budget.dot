digraph G {
    rankdir=TB;
    labelloc="t";
    label="上下文预算与成本治理";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="检索候选上下文"];
    n2 [label="按相关性排序打分"];
    n3 [label="受 Token 预算限制\n压缩·取舍·去重", fillcolor="#FCE9DB", color="#E8833A"];
    n4 [label="组装提示词"];
    n5 [label="生成与输出"];
    n6 [label="记录 Token 用量与成本"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; n5; n6 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> n5;
    n5 -> n6;
}
