digraph G {
    rankdir=LR;
    labelloc="t";
    label="智能维护四能力";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="逆向文档化\n源码 → 文档/调用图"];
    b [label="缺陷预测\n历史数据 → 缺陷高发区"];
    c [label="变更影响分析\n调用关系 → 波及范围"];
    d [label="补丁生成\n修复 + 回归验证"];

    { rank=same; a; c }
    { rank=same; b; d }

    a -> b [label="辅助决策"];
    b -> c;
    c -> d;
}
