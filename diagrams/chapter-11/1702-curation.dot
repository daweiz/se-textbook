digraph G {
    rankdir=TB;
    labelloc="t";
    label="代码策展流程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="阅读 AI 生成代码"];
    n2 [label="评估正确性与可维护性"];
    n3 [label="整合与修正"];
    n4 [label="测试与评审"];
    d  [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    ok [label="进入基线", fillcolor="#2C5F8A", fontcolor="white"];
    back [label="返回修改", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d; ok; back }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> ok [xlabel="是"];
    d -> back [xlabel="否"];
    back -> n3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="返回修改"];
}
