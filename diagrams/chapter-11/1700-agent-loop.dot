digraph G {
    rankdir=TB;
    labelloc="t";
    label="代码智能体的生成—审查—修复循环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.75, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A", newrank=true];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_dev {
        label="程序员智能体";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        gen  [label="生成代码"];
        fix  [label="根据评审意见修复", fillcolor="#FCE9DB", color="#E8833A"];
        reg  [label="重新生成"];
        fix2 [label="定位并修复", fillcolor="#FCE9DB", color="#E8833A"];
    }

    subgraph cluster_rev {
        label="审查者智能体";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        check   [label="静态检查与代码评审\n指出缺陷"];
        defect  [label="发现缺陷？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
        recheck [label="重新审查"];
    }

    subgraph cluster_ver {
        label="验证环境";
        style="rounded,dashed";
        color="#4A90D9";
        fontcolor="#2C5F8A";
        test [label="单元测试与回归验证"];
        pass [label="全部通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
        fin  [label="结束", fillcolor="#2C5F8A", fontcolor="white"];
    }

    { rank=same; gen; check }
    { rank=same; fix; defect; test }
    { rank=same; reg; recheck; pass }
    { rank=same; fix2; fin }

    gen -> check;
    check -> defect;
    defect -> fix [xlabel="是"];
    fix -> reg;
    reg -> recheck;
    recheck -> defect [style=dashed, color="#E8833A", constraint=false];
    defect -> test [xlabel="否"];
    test -> pass;
    pass -> fin [xlabel="是"];
    pass -> fix2 [label="否"];
    fix2 -> test [style=dashed, color="#E8833A", constraint=false];
}
