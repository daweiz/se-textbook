digraph G {
    rankdir=TB;
    labelloc="t";
    label="模型—代码双向同步闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.85, splines=ortho, pad=0.25, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="自然语言需求"];
    a2 [label="生成模型初稿\n（用例图/类图/顺序图）"];
    a3 [label="人工确定语义与边界"];
    a4 [label="由模型生成代码"];
    a5 [label="由代码逆向生成\n模型并比对"];
    d1 [label="模型与实现\n一致？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    a6 [label="一致性校验\n（OCL 约束检查）"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2 }
    { rank=same; a3; a4 }
    { rank=same; a5; d1 }
    { rank=same; a6; fin }

    a1 -> a2;
    a2 -> a3;
    a3 -> a4;
    a4 -> a5;
    a5 -> d1;
    d1 -> a6 [label="是"];
    d1 -> a5 [xlabel="否", style=dashed, color="#E8833A", fontcolor="#E8833A"];
    a6 -> fin;
}
