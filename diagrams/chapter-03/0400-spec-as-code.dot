digraph G {
    rankdir=LR;
    labelloc="t";
    label="需求即代码工作流";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.85, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="需求以规格文件表达\n（Gherkin/BDD 或结构化文本）"];
    n2 [label="纳入版本控制与评审"];
    n3 [label="AI 生成测试用例\n与实现骨架"];
    n4 [label="CI 执行规格校验\n（需求可测·用例通过）"];
    d  [label="规格校验\n通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    n5 [label="规格成为可执行的契约", fillcolor="#2C5F8A", fontcolor="white"];
    n6 [label="修正规格或实现", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d; n6 }
    { rank=same; n5 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> n5 [label="是"];
    d -> n6 [xlabel="否"];
    n6 -> n4 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="重新校验"];
}
