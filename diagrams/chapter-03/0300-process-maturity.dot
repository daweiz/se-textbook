digraph G {
    rankdir=TB;
    labelloc="t";
    label="AI 增强过程的成熟度层次";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    l3 [label="L3 智能体编排", fillcolor="#2C5F8A", fontcolor="white"];
    l2 [label="L2 流水线嵌入", fillcolor="#2C5F8A", fontcolor="white"];
    l1 [label="L1 点状辅助", fillcolor="#2C5F8A", fontcolor="white"];

    d3 [label="AI 接受高层目标\n人负责定义与验收"];
    d2 [label="质量门禁前移到\n每一次提交"];
    d1 [label="AI 作为个别\n活动的工具"];

    { rank=same; l3; d3 }
    { rank=same; l2; d2 }
    { rank=same; l1; d1 }

    l3 -> l2 [label="演进"];
    l2 -> l1 [label="演进"];
    d3 -> d2 [style=invis];
    d2 -> d1 [style=invis];
}
