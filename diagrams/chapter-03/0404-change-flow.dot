digraph G {
    rankdir=LR;
    labelloc="t";
    label="需求变更控制流程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.75, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    A [label="变更请求"];
    B [label="变更评审", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    C [label="记录拒绝原因", fillcolor="#FCE9DB", color="#E8833A"];
    D [label="评估影响范围"];
    E [label="更新需求基线"];
    F [label="同步设计与测试"];
    G [label="变更验证与确认", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; A; B; C }
    { rank=same; D; E }
    { rank=same; F; G }

    A -> B;
    B -> C [label="拒绝"];
    B -> D [label="接受"];
    D -> E;
    E -> F;
    F -> G;
}
