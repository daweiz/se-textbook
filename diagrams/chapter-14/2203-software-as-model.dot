digraph G {
    rankdir=TB;
    labelloc="t";
    label="软件即模型：软件的复合构成";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="软件\n（模型 + 数据 +\n提示 + 工具 + 代码）", fillcolor="#2C5F8A", fontcolor="white"];
    f1 [label="模型\n生成与推理"];
    f2 [label="数据\n训练与检索"];
    f3 [label="提示\n指令与上下文"];
    f4 [label="工具\n外部能力"];
    f5 [label="代码\n传统构成"];
    note [label="制造方式：训练 · 微调 · 提示 · 编写", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; f1; f2 }
    { rank=same; hub }
    { rank=same; f3; f4; f5 }
    { rank=same; note }

    f1 -> hub;
    f2 -> hub;
    hub -> f3;
    hub -> f4;
    hub -> f5;
    hub -> note [style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
