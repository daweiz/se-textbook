digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能体工程的计划—执行—验证循环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    p [label="规划 Plan\n任务书 + 质量门禁", fillcolor="#2C5F8A", fontcolor="white"];
    e [label="执行 Execute\n智能体自主实施"];
    v [label="验证 Verify\n评测 + 审计轨迹"];

    { rank=same; p; e }
    { rank=same; v }

    p -> e;
    e -> v;
    v -> p [style=dashed, color="#E8833A", fontcolor="#E8833A", label="未通过 / 迭代"];
}
