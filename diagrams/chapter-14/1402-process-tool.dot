digraph G {
    rankdir=LR;
    labelloc="t";
    label="过程驱动工具";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.9, ranksep=0.5, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    start [label="开始", shape=ellipse, fillcolor="#DCE9F7"];
    n1 [label="明确方法学与过程"];
    n2 [label="梳理工具需求"];
    n3 [label="评估候选工具"];
    dec [label="匹配?", shape=diamond, fillcolor="#FFF3D6", color="#E8833A", fontcolor="#333333"];
    nneg [label="调整工具选择", fillcolor="#FCE9DB", color="#E8833A"];
    y1 [label="集成到开发流程"];
    y2 [label="验证支撑效果"];
    nend [label="结束", shape=ellipse, fillcolor="#DCE9F7"];

    { rank=same; start; n1 }
    { rank=same; n2; n3 }
    { rank=same; dec; nneg }
    { rank=same; y1; y2 }
    { rank=same; nend }

    start -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> dec;
    dec -> y1 [xlabel="是"];
    y1 -> y2;
    y2 -> nend;
    dec -> nneg [xlabel="否"];
    nneg -> n3 [style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
