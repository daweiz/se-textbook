digraph G {
    rankdir=TB;
    labelloc="t";
    label="提示词与模型配置项的生命周期";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    start [label="", shape=circle, width=0.22, fixedsize=true, fillcolor="#2C5F8A", color="#2C5F8A"];
    draft  [label="草稿"];
    review [label="评审"];
    publish [label="发布"];
    active [label="使用中"];
    eval   [label="评测"];
    update [label="更新"];
    rollback [label="回滚"];
    note [label="提示词与模型配置作为配置项纳入版本管理，\n记录版本、所依赖模型与参数、评测结果，使产出可追溯",
          shape=box, style="rounded,filled,dashed", fillcolor="#FFF3D6", color="#E8833A", fontcolor="#333333"];

    { rank=same; start; draft; publish; eval; rollback }
    { rank=same; review; active; update }
    { rank=same; note }

    draft -> publish [style=invis];
    publish -> eval [style=invis];
    review -> active [style=invis];

    start -> draft;
    draft -> review;
    review -> publish;
    publish -> active;
    active -> eval;
    eval -> update;
    eval -> rollback;
    update -> review [style=dashed, color="#E8833A", fontcolor="#E8833A"];
    rollback -> draft [style=dashed, color="#E8833A", fontcolor="#E8833A"];
    active -> note [style=invis];
}
