digraph G {
    rankdir=TB;
    labelloc="t";
    label="设计模式的四要素";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="① 模式名称\n（便于交流与思考）"];
    b [label="② 问题\n（何时使用·前因后果）"];
    c [label="③ 解决方案\n（结构·职责·协作）"];
    d [label="④ 效果\n（应用效果与权衡）"];
    hub [label="设计模式\n四要素", fillcolor="#2C5F8A", fontcolor="white"];
    note [label="模式的本质是权衡\nAI 生成模式代码时应说明\n正在解决哪个变化点、带来什么代价", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; a; b }
    { rank=same; c; d }

    a -> hub [style=invis];
    b -> hub [style=invis];
    hub -> a [constraint=false];
    hub -> b [constraint=false];
    hub -> c;
    hub -> d;
    d -> note [style=invis];
}
