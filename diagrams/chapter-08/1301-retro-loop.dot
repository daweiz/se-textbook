digraph G {
    rankdir=TB;
    labelloc="t";
    label="项目复盘的度量闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.45, ranksep=0.9, splines=ortho, pad=0.25, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.15,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="度量仪表盘\n（SPI/CPI·缺陷率·DORA）"];
    a2 [label="项目复盘\n（时间线·KPT·五个为什么）"];
    a3 [label="行动项\n（负责人·时限·验证）"];
    a4 [label="再度量\n验证改进效果"];
    d1 [label="达到目标？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="分析未达标原因\n纳入下一轮复盘", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; a4 }
    { rank=same; d1; fin }
    { rank=same; b1 }

    a1 -> a2;
    a2 -> a3;
    a3 -> a4;
    a4 -> d1;
    d1 -> fin [xlabel="是"];
    d1 -> b1 [label="否"];
    b1 -> a2 [style=dashed, color="#E8833A", fontcolor="#E8833A", constraint=false, label="调整后\n再改进"];
}
