digraph G {
    rankdir=TB;
    labelloc="t";
    label="需求规格说明的质量特性";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.85, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2, dir=none];

    hub [label="需求规格说明\n（SRS）", fillcolor="#2C5F8A", fontcolor="white"];
    c1 [label="正确"];
    c2 [label="无二义"];
    c3 [label="完整"];
    c4 [label="可验证"];
    c5 [label="一致"];
    c6 [label="可修改"];
    c7 [label="可跟踪"];

    { rank=same; c1; c2; c3; c4 }
    { rank=same; c5; c6; c7 }

    c1 -> hub;
    c2 -> hub;
    c3 -> hub;
    c4 -> hub;
    hub -> c5;
    hub -> c6;
    hub -> c7;
}
