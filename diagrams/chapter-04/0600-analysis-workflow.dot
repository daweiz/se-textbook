digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能分析工作流";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.65, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    A [label="用例文本与需求描述"];
    B [label="LLM 枚举候选类\n（实体类/边界类/控制类）"];
    C [label="人工审查候选清单\n（合并/取舍/修正）"];
    D [label="生成数据字典\n与词汇表"];
    E [label="LLM 对照检查清单\n扫描一致性"];
    d [label="发现遗漏\n或不一致？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    F [label="修订分析模型", fillcolor="#FCE9DB", color="#E8833A"];
    G [label="重新检查", fillcolor="#FCE9DB", color="#E8833A"];
    H [label="输出分析模型\n（类图/交互图）", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; A; B }
    { rank=same; C; D }
    { rank=same; E; d }
    { rank=same; F; G }
    { rank=same; H }

    A -> B;
    B -> C;
    C -> D;
    D -> E;
    E -> d;
    d -> F [label="是"];
    d -> H [label="否"];
    F -> G;
    G -> E [style=dashed, color="#E8833A", fontcolor="#E8833A", label="循环"];
}
