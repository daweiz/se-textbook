digraph G {
    rankdir=LR;
    labelloc="t";
    label="智能需求工程工作流";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.45, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="录音与访谈记录"];
    n2 [label="语音转写为文本"];
    n3 [label="LLM 抽取需求条目\n（业务目标/功能/非功能）"];
    n4 [label="人工确认与补充\n（拒绝/修正/接受）"];
    d  [label="需求存在歧义\n或冲突？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A", fontcolor="#333333"];
    n5 [label="对话式需求澄清\n追问边界条件", fillcolor="#FCE9DB", color="#E8833A"];
    n6 [label="生成用例与 SRS 初稿"];
    n7 [label="完整性检查\n（对照 IEEE 830）"];
    n8 [label="生成需求跟踪矩阵\n（需求—用例—测试）"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d; n5 }
    { rank=same; n6; n7 }
    { rank=same; n8 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> n5 [label="是"];
    d -> n6 [label="否"];
    n5 -> n6;
    n6 -> n7;
    n7 -> n8;
}
