digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能时代的伦理挑战";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.2, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="算法偏见\n歧视性结果"];
    b [label="内容可靠性\n幻觉与错误"];
    c [label="数据与隐私\n数据收集处理"];
    d [label="就业与责任\n责任归属·角色演变"];
    e [label="透明度与可解释性\n可审计可解释"];
    m [label="工程机制\n原则倡导→可执行动作", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a; b; c }
    { rank=same; m }
    { rank=same; d; e }

    a -> m;
    b -> m;
    c -> m;
    m -> d [dir=back];
    m -> e [dir=back];
}
