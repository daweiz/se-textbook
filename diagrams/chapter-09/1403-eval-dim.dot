digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能工具评估维度";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a [label="技术栈匹配"];
    b [label="过程支撑"];
    c [label="模型与数据治理"];
    m [label="选型决策", fillcolor="#2C5F8A", fontcolor="white"];
    d [label="可验证性"];
    e [label="成本与演进"];

    { rank=same; a; b; c }
    { rank=same; m }
    { rank=same; d; e }

    a -> m;
    b -> m;
    c -> m;
    m -> d [dir=back];
    m -> e [dir=back];
}
