digraph G {
    rankdir=LR;
    labelloc="t";
    label="代码策展：智能编码时代的新角色";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="AI 生成代码与补全建议"];
    n2 [label="阅读与评估\n（可编译 ≠ 可维护）"];
    n3 [label="规范与审查约束\n（命名·结构·异常路径）"];
    d  [label="高风险部分？\n（内存/并发/异常）", shape=diamond, fillcolor="#FFF3D6", color="#E8833A", fontcolor="#333333"];
    n4 [label="人工逐行评审\n（显式说明资源与\n并发假设）", fillcolor="#FCE9DB", color="#E8833A"];
    n5 [label="静态检查 + 单元测试把关"];
    n6 [label="进入基线", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; n1; n2; n3 }
    { rank=same; d; n4 }
    { rank=same; n5; n6 }

    n1 -> n2;
    n2 -> n3;
    n3 -> d;
    d -> n4 [xlabel="是"];
    d -> n5 [xlabel="否"];
    n4 -> n5;
    n5 -> n6;
}
