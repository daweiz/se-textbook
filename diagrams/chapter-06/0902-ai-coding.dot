digraph G {
    rankdir=LR;
    labelloc="t";
    label="人机协作编码";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="人\n定义目标与编码规范"];
    n2 [label="AI\n生成代码·补全·重构"];
    n3 [label="AI\n静态检查·安全扫描·自检"];
    n4 [label="人\n逐行审查"];
    d  [label="通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A", fontcolor="#333333"];
    n5 [label="合并进入基线", fillcolor="#2C5F8A", fontcolor="white"];
    n6 [label="人\n指出问题"];
    n7 [label="AI\n修正"];
    n8 [label="人\n复查"];

    { rank=same; n1; n5 }
    { rank=same; n2; d; n6 }
    { rank=same; n3; n4; n7 }
    { rank=same; n8 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> n5 [xlabel="是"];
    d -> n6 [xlabel="否", style=dashed, color="#E8833A", fontcolor="#E8833A"];
    n6 -> n7 [style=dashed, color="#E8833A", fontcolor="#E8833A"];
    n7 -> n8 [style=dashed, color="#E8833A", fontcolor="#E8833A"];
    n8 -> n4 [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="返回"];
}
