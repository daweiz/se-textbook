digraph G {
    rankdir=TB;
    labelloc="t";
    label="AI 辅助事件风暴与 DDD 建模";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.45, ranksep=0.95, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    A [label="业务叙事与用户旅程\n（访谈/文档/现场观察）"];
    B [label="识别领域事件\n（LLM 自动枚举候选）"];
    C [label="按时间排序\n形成事件流"];
    D [label="聚合与限界上下文\n（把相关事件与实体分组）"];
    E [label="上下文映射\n（团队边界与协作关系）"];
    F [label="模型驱动设计\n（实体·值对象·领域服务）", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; A; B }
    { rank=same; C; D }
    { rank=same; E; F }

    A -> B;
    B -> C;
    C -> D;
    D -> E;
    E -> F;
}
