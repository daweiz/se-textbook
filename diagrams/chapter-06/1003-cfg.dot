digraph G {
    rankdir=LR;
    labelloc="t";
    label="控制流图（CFG）示例";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.85, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=circle, style="filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, width=0.7, fixedsize=true];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="入口", fillcolor="#2C5F8A", fontcolor="white"];
    n2 [label="2", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    n3 [label="3"];
    n4 [label="4"];
    n5 [label="5"];
    n6 [label="6"];
    n7 [label="出口", shape=doublecircle, fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; n3; n4 }
    { rank=same; n5; n6 }

    n1 -> n2;
    n2 -> n3 [label="C1"];
    n2 -> n4 [label="¬C1"];
    n3 -> n5;
    n4 -> n5;
    n5 -> n6;
    n6 -> n7;
}
