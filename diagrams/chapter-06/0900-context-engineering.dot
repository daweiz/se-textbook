digraph G {
    rankdir=LR;
    labelloc="t";
    label="项目上下文工程闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=1.8, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    s1 [label="收集项目上下文\n（架构文档·规范·代码样例）"];
    s2 [label="组织为可检索知识库\n（项目约定文件·检索索引）"];
    s3 [label="编码时检索上下文\n（按任务动态拼装）"];
    s4 [label="生成补全与建议\n（贴合项目实际）"];
    s5 [label="采纳/反馈\n（采纳率·问题记录）"];
    s6 [label="沉淀回知识库\n（新约定·新样例）"];

    { rank=same; s1; s6 }
    { rank=same; s2; s5 }
    { rank=same; s3; s4 }

    s1 -> s2;
    s2 -> s3;
    s3 -> s4;
    s4 -> s5;
    s5 -> s6;
    s6 -> s1 [constraint=false, style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="闭环"];
}
