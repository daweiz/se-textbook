digraph G {
    rankdir=LR;
    labelloc="t";
    label="信任与可验证性的递进";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.9, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    subgraph cluster_trust {
        label="信任的四要素";
        color="#9AA7B4";
        style=rounded;
        t1 [label="目标一致\n意图与规格对齐"];
        t2 [label="表现稳定\n行为可复现"];
        t3 [label="可追溯\n来源与理由"];
        t4 [label="可回滚\n失败可恢复"];
    }

    hub [label="信任 = 可验证性\n的递进", fillcolor="#2C5F8A", fontcolor="white"];

    subgraph cluster_verify {
        label="验证手段";
        color="#9AA7B4";
        style=rounded;
        v1 [label="评测集回归"];
        v2 [label="分级门禁"];
        v3 [label="审计轨迹"];
        v4 [label="沙箱演练"];
    }

    t1 -> hub;
    t2 -> hub;
    t3 -> hub;
    t4 -> hub;
    hub -> v1;
    hub -> v2;
    hub -> v3;
    hub -> v4;
}
