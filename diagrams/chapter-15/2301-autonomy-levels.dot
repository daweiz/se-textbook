digraph G {
    rankdir=TB;
    labelloc="t";
    label="自主性分级模型 L0–L5";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.8, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    l0 [label="L0 全人工\n人完成全部开发"];
    l1 [label="L1 建议\n模型给出建议，人决定"];
    l2 [label="L2 审批执行\n人批准后智能体执行"];
    l3 [label="L3 授权自主\n授权范围内自主完成"];
    l4 [label="L4 有条件自治\n满足条件即自治"];
    l5 [label="L5 完全自治\n智能体全程自主", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; l0; l1 }
    { rank=same; l2; l3 }
    { rank=same; l4; l5 }

    l0 -> l1;
    l1 -> l2;
    l2 -> l3;
    l3 -> l4;
    l4 -> l5;
}
