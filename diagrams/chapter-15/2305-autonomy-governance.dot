digraph G {
    rankdir=TB;
    labelloc="t";
    label="自主软件工程的风险与治理";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="自主软件工程治理\n约束自主化的四条红线", fillcolor="#2C5F8A", fontcolor="white"];
    g1 [label="分级门禁\n破坏性动作留人工"];
    g2 [label="成本配额\n限制自动化规模"];
    g3 [label="最小权限\n工具与数据按需"];
    g4 [label="责任归属\n部署者负责"];

    { rank=same; g1; g2 }
    { rank=same; hub }
    { rank=same; g3; g4 }

    g1 -> hub;
    g2 -> hub;
    hub -> g3;
    hub -> g4;
}
