digraph G {
    rankdir=LR;
    labelloc="t";
    label="自主开发流水线与阶段门禁";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.09"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    r1 [label="规划智能体\n任务分解"];
    r2 [label="实现智能体\n生成代码"];
    r3 [label="测试智能体\n生成并执行用例"];
    r4 [label="评审智能体\n对照规格检查"];
    g1 [label="阶段门禁\n高风险动作人工确认", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    back [label="未通过返回\n重生成 / 重测试", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="合入基线", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; r1; r2 }
    { rank=same; r3; r4 }
    { rank=same; g1; back; fin }

    r1 -> r2;
    r2 -> r3;
    r3 -> r4;
    r4 -> g1;
    g1 -> fin [xlabel="通过"];
    g1 -> back [xlabel="未通过"];
    back -> r2 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="修正"];
}
