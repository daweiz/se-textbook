digraph G {
    rankdir=TB;
    labelloc="t";
    label="AI 原生软件工程的能力栈";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.5, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    g [label="治理层\n安全与合规·伦理与责任·评测与审计"];
    q [label="工程层\n代码策展·上下文工程·智能体编排·质量门禁"];
    w [label="工具层\nAI 编码助手·对话式开发·自动化流水线·知识库"];
    m [label="模型层\n基础大模型·领域微调模型"];

    g -> q;
    q -> w;
    w -> m;
}
