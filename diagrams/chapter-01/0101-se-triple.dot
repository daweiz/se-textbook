digraph G {
    rankdir=TB;
    labelloc="t";
    label="软件工程三要素";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    proc [label="软件工程过程\n过程域·活动与任务"];
    meth [label="软件工程方法\n结构化·面向对象·智能化"];
    tool [label="软件工程工具\nCASE·智能工具链"];

    { rank=same; meth; tool }

    proc -> meth;
    meth -> tool;
    proc -> tool;
}
