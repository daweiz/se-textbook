digraph G {
    rankdir=LR;
    labelloc="t";
    label="软件生命周期";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.45, ranksep=0.95, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=12, margin="0.22,0.11"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    A [label="问题定义"];
    B [label="可行性研究"];
    C [label="需求分析"];
    D [label="设计"];
    E [label="实现"];
    F [label="测试"];
    G [label="运行维护"];
    H [label="退役"];

    { rank=same; A; B }
    { rank=same; C; D }
    { rank=same; E; F }
    { rank=same; G; H }

    A -> B;
    B -> C;
    C -> D;
    D -> E;
    E -> F;
    F -> G;
    G -> H;
}
