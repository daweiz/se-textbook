digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能软件工程治理闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.6, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.22,0.12"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    m [label="度量\n暴露问题", fillcolor="#2C5F8A", fontcolor="white"];
    g [label="治理\n调整手段"];
    e [label="评测\n验证效果"];
    a [label="审计\n留存证据"];
    r [label="回灌\n写回评测集"];

    { rank=same; m; g; e }
    { rank=same; a; r }

    m -> g;
    g -> e;
    e -> a;
    a -> r;
    r -> m [style=dashed, color="#E8833A", fontcolor="#E8833A", label="持续学习"];
}
