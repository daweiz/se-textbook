digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能体评估流水线";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=1.3, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=10.5, margin="0.18,0.08"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="构建任务基准\n（SWE-bench 类\n·领域任务集）"];
    a2 [label="沙箱环境运行\n（隔离·可复现）"];
    a3 [label="采集执行轨迹\n（步骤·工具调用\n·中间结果）"];
    a4 [label="多维度评估\n（任务成功率·轨迹\n·质量·效率）"];
    a5 [label="与历史版本\n回归对比"];
    d1 [label="退化？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="定位并改进\n（提示词·工具\n·上下文）", fillcolor="#FCE9DB", color="#E8833A"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; a4; a5; d1 }
    { rank=same; b1; fin }

    a1 -> a2;
    a2 -> a3;
    a3 -> a4;
    a4 -> a5;
    a5 -> d1;
    d1 -> b1 [label="是"];
    d1 -> fin [label="否"];
    b1 -> a4 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="重新评估"];
}
