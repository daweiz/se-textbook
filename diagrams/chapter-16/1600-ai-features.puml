@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam {
  defaultFontName "Microsoft YaHei"
  shadowing false
  ActivityBackgroundColor #DCE9F7
  ActivityBorderColor #2C5F8A
  ActivityFontColor #333333
  ActivityDiamondBackgroundColor #FFF3D6
  ActivityDiamondBorderColor #E8833A
  ComponentBackgroundColor #DCE9F7
  ComponentBorderColor #2C5F8A
  ComponentFontColor #333333
  ArrowColor #9AA7B4
  ArrowFontColor #333333
}
title AI 系统的三个工程特性
component "行为由数据驱动\n而非代码确定\n数据质量=行为质量" as d
component "行为具有非确定性\n输出是分布而非\n单一正确结果" as n
component "随时间老化\n数据分布漂移\n性能持续下降" as a
component "AI 组件/系统" as core
core --> d
core --> n
core --> a
@enduml