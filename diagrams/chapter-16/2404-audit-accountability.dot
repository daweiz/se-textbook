digraph G {
    rankdir=TB;
    labelloc="t";
    label="度量、审计与责任的闭环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.8, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    m [label="度量\n效果如何", fillcolor="#2C5F8A", fontcolor="white"];
    a [label="审计\n能否举证"];
    r [label="责任\n谁来承担"];

    { rank=same; m; a }
    { rank=same; r }

    m -> a;
    a -> r;
    r -> m [style=dashed, color="#E8833A", fontcolor="#E8833A", label="回灌改进"];
}
