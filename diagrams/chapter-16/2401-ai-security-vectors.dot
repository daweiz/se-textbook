digraph G {
    rankdir=TB;
    labelloc="t";
    label="大模型时代的四类新型安全威胁";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.7, ranksep=0.6, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    hub [label="大模型时代\n软件安全", fillcolor="#2C5F8A", fontcolor="white"];
    t1 [label="提示注入\n操纵智能体越权"];
    t2 [label="供应链投毒\n恶意依赖与模型"];
    t3 [label="数据污染\n行为被定向带偏"];
    t4 [label="模型漂移\n行为偏离规格"];
    note [label="防线：生成时验证 · 运行时监控\n审计时追溯 · 全程可信", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; t1; t2 }
    { rank=same; hub }
    { rank=same; t3; t4; note }

    t1 -> hub;
    t2 -> hub;
    hub -> t3;
    hub -> t4;
    hub -> note [style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
