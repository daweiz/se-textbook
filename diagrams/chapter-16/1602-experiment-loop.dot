digraph G {
    rankdir=TB;
    labelloc="t";
    label="实验管理循环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.8, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    a1 [label="配置实验"];
    a2 [label="记录代码·数据\n·超参数"];
    a3 [label="在独立评测集\n上评测"];
    d1 [label="指标\n达标？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    b1 [label="登记模型\n注册表"];
    b2 [label="通过门槛\n晋升部署"];
    fin [label="结束", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; a1; a2; a3 }
    { rank=same; d1 }
    { rank=same; b1; b2; fin }

    a1 -> a2;
    a2 -> a3;
    a3 -> d1;
    d1 -> b1 [label="是"];
    b1 -> b2;
    b2 -> fin;
    d1 -> a1 [style=dashed, color="#E8833A", fontcolor="#E8833A", xlabel="否（重配实验）"];
}
