digraph G {
    rankdir=TB;
    labelloc="t";
    label="智能形式化验证流程";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.55, ranksep=0.65, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="自然语言需求 / UML 模型"];
    n2 [label="LLM 生成规格初稿\n（Z/OCL/时序逻辑）"];
    n3 [label="验证工具检查\n（语法/类型/一致性）"];
    n4 [label="模型检验与符号执行\n（NuSMV/SPIN/KLEE）"];
    d  [label="性质被违反？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    n5 [label="确认性质成立", fillcolor="#2C5F8A", fontcolor="white"];
    y1 [label="解析反例轨迹\n定位违规场景", fillcolor="#FCE9DB", color="#E8833A"];
    y2 [label="提出修复建议", fillcolor="#FCE9DB", color="#E8833A"];
    y3 [label="修订规格或系统", fillcolor="#FCE9DB", color="#E8833A"];
    y4 [label="重新验证", fillcolor="#FCE9DB", color="#E8833A"];

    { rank=same; n1; n2 }
    { rank=same; n3; n4 }
    { rank=same; d; n5 }
    { rank=same; y1; y2 }
    { rank=same; y3; y4 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> n5 [xlabel="否"];
    d -> y1 [label="是"];
    y1 -> y2;
    y2 -> y3;
    y3 -> y4;
    y4 -> n3 [style=dashed, color="#E8833A", fontcolor="#E8833A", label="循环"];
}
