digraph G {
    rankdir=TB;
    labelloc="t";
    label="LLM 辅助形式化验证循环";
    graph [fontname="Microsoft YaHei", bgcolor="white", nodesep=0.5, ranksep=0.7, splines=ortho, pad=0.3, fontsize=15, fontcolor="#2C5F8A"];
    node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fillcolor="#DCE9F7", color="#2C5F8A", fontcolor="#333333", penwidth=1.3, fontsize=11, margin="0.2,0.1"];
    edge [fontname="Microsoft YaHei", fontsize=10, color="#9AA7B4", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

    n1 [label="自然语言需求"];
    n2 [label="LLM 生成/修正规格"];
    n3 [label="验证器·证明助手\n检查"];
    d  [label="验证通过？", shape=diamond, fillcolor="#FFF3D6", color="#E8833A"];
    n4 [label="AI 分析反例\n并给出修复建议", fillcolor="#FCE9DB", color="#E8833A"];
    n5 [label="规格确认进入基线", fillcolor="#2C5F8A", fontcolor="white"];

    { rank=same; n1; n2; n3 }
    { rank=same; d; n4 }
    { rank=same; n5 }

    n1 -> n2;
    n2 -> n3;
    n3 -> n4;
    n4 -> d;
    d -> n5 [label="是"];
    d -> n1 [xlabel="否", style=dashed, color="#E8833A", fontcolor="#E8833A"];
}
